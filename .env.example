# Supabase > Project Settings > API Keys sayfasından alınır.
# Bunlar tarayıcıya açık gider; service_role / secret anahtarı BURAYA KONMAZ.
NEXT_PUBLIC_SUPABASE_URL=https://PROJE_KIMLIGI.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Yalnızca SUNUCUDA kullanılır. NEXT_PUBLIC_ ile BAŞLAMAZ, tarayıcıya gitmez.
OPENAI_API_KEY=sk-...
# İsteğe bağlı (varsayılan: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Gemini (öncelikli): aistudio.google.com > Get API key. Yalnızca sunucuda.
GEMINI_API_KEY=...
# İsteğe bağlı (varsayılan: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
